# Browser-safe Supabase project values. These may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=

# Optional: use a different bucket name only when the matching migration is updated.
SUPABASE_DOCUMENTS_BUCKET=documents
